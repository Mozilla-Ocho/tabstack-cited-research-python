{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tabstack:editorial:week4:question:v1",
  "title": "Proposed live-web acceptance question record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "question", "required_elements", "reference_sources", "evidence_status", "critical_failure_conditions"],
  "properties": {
    "id": {"type": "string", "pattern": "^Q[0-9]{2}$"},
    "category": {"enum": ["source_discovery", "exact_contract", "synthesis", "freshness_scope", "limits_uncertainty"]},
    "question": {"type": "string", "minLength": 15},
    "required_elements": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "criterion"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[1-5]$"},
          "criterion": {"type": "string", "minLength": 10}
        }
      }
    },
    "reference_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "passage", "retrieved_at_utc", "date_or_version"],
        "properties": {
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "passage": {"type": ["string", "null"]},
          "retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
          "date_or_version": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_status": {"enum": ["pending", "reviewed"]},
    "critical_failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_status": {"const": "reviewed"}}, "required": ["evidence_status"]},
      "then": {
        "properties": {
          "reference_sources": {
            "items": {
              "properties": {
                "passage": {"type": "string", "minLength": 5},
                "retrieved_at_utc": {"type": "string", "format": "date-time"},
                "date_or_version": {"type": "string", "minLength": 5}
              }
            }
          }
        }
      }
    }
  ]
}
